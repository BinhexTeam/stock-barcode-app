<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="stock_barcode_oca.BarcodeInterface">
        <div class="stock_barcode_interface">
            <!-- HEADER -->
            <div class="barcode_header">
                <button
                    class="btn btn-secondary barcode_close_btn"
                    t-on-click="onClose"
                >
                    <i class="fa fa-times" />
                </button>
                <div class="barcode_header_title">
                    <div>
                        <h4 class="barcode_title" t-esc="state.pickingName" />
                        <div t-if="state.partnerName">
                            <i
                                class="fa fa-user"
                                style="margin-right: 6px; margin-end: 6px;"
                            />
                            <span class="barcode_partner" t-esc="state.partnerName" />
                        </div>
                    </div>
                </div>
                <button
                    class="btn btn-primary barcode_scan_btn"
                    t-on-click="onScanWithCamera"
                    title="Camera Scan"
                >
                    <i class="fa fa-barcode" />
                </button>
            </div>

            <!-- SCANNING GUIDE AREA -->
            <div
                class="barcode_scanning_guide"
                t-if="state.profileConfig.scanning_sequence.length > 0"
            >
                <!-- INSTRUCTION CARD (estilo tarjeta producto, color diferente) -->
                <div class="instruction_card">
                    <div class="instruction_text">
                        <i class="fa fa-info-circle" style="margin-right: 8px;" />
                        <span t-esc="state.scanInstructions or 'Scan next code'" />
                    </div>
                </div>

                <!-- STEPS (simple, 3 colores, clickeable) -->
                <div
                    class="sequence_steps"
                    t-ref="stepsContainer"
                    t-if="state.profileConfig.scanning_sequence.length > 0"
                >
                    <t
                        t-foreach="state.profileConfig.scanning_sequence"
                        t-as="step"
                        t-key="step.id"
                    >
                        <div
                            t-attf-class="step_block step_{{step.step_type}} {{state.currentStepId === step.id ? 'active' : ''}}"
                            t-on-click="() => this.onForceStep(step.id)"
                        >
                            <span t-esc="step.name" />
                        </div>
                    </t>
                </div>
            </div>

            <!-- CONTENT (tarjetas de producto) -->
            <div class="barcode_content">
                <div t-if="state.moveLines.length === 0" class="empty_state">
                    <i class="fa fa-barcode fa-4x text-muted" />
                    <p class="text-muted">No products found</p>
                </div>

                <div t-else="" class="move_lines_container">
                    <t t-foreach="state.moveLines" t-as="line" t-key="line.id">
                        <div class="move_line_card">
                            <!-- GRID 2x2 -->
                            <div class="card_grid">
                                <!-- TOP LEFT: Product info -->
                                <div class="grid_top_left">
                                    <span
                                        t-if="line.product_code"
                                        class="product_code"
                                        t-esc="line.product_code"
                                    />
                                    <span
                                        class="product_name"
                                        t-esc="line.product_name"
                                    />
                                </div>

                                <!-- TOP RIGHT: Edit button -->
                                <div class="grid_top_right">
                                    <button
                                        class="btn btn-sm btn-primary"
                                        t-on-click="() => this.onOpenLineEditor(line.id)"
                                    >
                                        <i class="fa fa-pencil" />
                                    </button>
                                </div>

                                <!-- BOTTOM LEFT: Qty picked/demand + UoM -->
                                <div class="grid_bottom_left">
                                    <span class="qty_display">
                                        <span
                                            class="qty_picked"
                                            t-esc="line.qty_picked"
                                        />
                                        <span>/</span>
                                        <span
                                            class="qty_demand"
                                            t-esc="line.quantity_demand"
                                        />
                                        <span class="uom" t-esc="line.product_uom" />
                                    </span>
                                </div>

                                <!-- BOTTOM RIGHT: Botones +1, -1, +X -->
                                <div class="grid_bottom_right">
                                    <div class="qty_buttons">
                                        <button
                                            t-if="this.showMinusOne(line)"
                                            class="btn btn-sm btn-secondary qty_btn"
                                            t-on-click="() => this.onIncrementQty(line.id, -1)"
                                        >
                                            -1
                                        </button>
                                        <button
                                            t-if="this.showPlusOne(line)"
                                            class="btn btn-sm btn-primary qty_btn"
                                            t-on-click="() => this.onIncrementQty(line.id, 1)"
                                        >
                                            +1
                                        </button>
                                        <button
                                            t-if="this.showPlusRemainder(line)"
                                            class="btn btn-sm btn-success qty_btn"
                                            t-on-click="() => this.onIncrementQty(line.id, this.getRemainder(line))"
                                        >
                                            +<t t-esc="this.getRemainder(line)" />
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <div class="barcode_footer">
                <!-- Progress bar en footer -->
                <div class="footer_progress_container" t-if="state.inCyclicFlow">
                    <div class="progress_bar">
                        <div
                            class="progress_fill"
                            t-attf-style="width: {{(state.pickedQty / state.totalQty * 100)}}%"
                        />
                        <span class="progress_label">
                            <t t-esc="Math.round(state.pickedQty)" /> / <t
                                t-esc="Math.round(state.totalQty)"
                            /> units
                        </span>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="footer_actions">
                    <button
                        class="btn footer_btn footer_btn_validate"
                        t-on-click="onValidate"
                        title="Validate Picking"
                    >
                        <i class="fa fa-check" />
                    </button>
                    <button
                        class="btn footer_btn footer_btn_chatter"
                        t-on-click="onToggleChatter"
                        title="Notes"
                    >
                        <i class="fa fa-sticky-note-o" />
                    </button>
                </div>
            </div>

            <!-- Mini Chatter Fullscreen -->
            <div class="mini_chatter" t-if="state.showChatter">
                <div class="chatter_header">
                    <button
                        class="btn btn-secondary chatter_btn"
                        t-on-click="onCloseChatter"
                        title="Close"
                    >
                        <i class="fa fa-times" />
                    </button>
                    <div class="chatter_header_actions">
                        <button
                            class="btn btn-secondary chatter_btn"
                            t-on-click="onAttachFile"
                            title="Attach file"
                        >
                            <i class="fa fa-paperclip" />
                        </button>
                        <button
                            class="btn btn-secondary chatter_btn"
                            t-on-click="onOpenMentionList"
                            title="Mention user"
                        >
                            <i class="fa fa-at" />
                        </button>
                        <button
                            class="btn btn-primary chatter_btn chatter_btn_post"
                            t-on-click="onPostMessage"
                            title="Post message"
                        >
                            <i class="fa fa-paper-plane" />
                        </button>
                    </div>
                </div>

                <div class="chatter_body">
                    <textarea
                        class="form-control chatter_textarea"
                        placeholder="Write a note..."
                        t-model="state.chatterMessage"
                        rows="6"
                    />

                    <!-- Lista de archivos adjuntos -->
                    <div
                        class="chatter_attachments"
                        t-if="state.chatterAttachments.length > 0"
                    >
                        <t
                            t-foreach="state.chatterAttachments"
                            t-as="attachment"
                            t-key="attachment_index"
                        >
                            <div class="attachment_chip">
                                <i class="fa fa-file-o" />
                                <span t-esc="attachment.name" />
                                <button
                                    class="btn btn-sm btn-link"
                                    t-on-click="() => this.removeAttachment(attachment_index)"
                                    style="padding: 0; margin-left: 4px;"
                                >
                                    <i class="fa fa-times" />
                                </button>
                            </div>
                        </t>
                    </div>

                    <!-- Lista de menciones -->
                    <div class="mention_list" t-if="state.showMentionList">
                        <div class="mention_search">
                            <i class="fa fa-search" />
                            <input
                                type="text"
                                class="form-control mention_search_input"
                                placeholder="Search users..."
                                t-model="state.mentionSearchText"
                                t-ref="mentionSearchInput"
                            />
                        </div>
                        <div class="mention_list_items">
                            <t t-if="this.getFilteredMentionableUsers().length === 0">
                                <div class="mention_item mention_item_empty">
                                    <t
                                        t-if="state.mentionableUsers.length === 0"
                                    >No users available</t>
                                    <t t-else="">No users found</t>
                                </div>
                            </t>
                            <t t-else="">
                                <t
                                    t-foreach="this.getFilteredMentionableUsers()"
                                    t-as="user"
                                    t-key="user.id"
                                >
                                    <div
                                        class="mention_item"
                                        t-on-click="() => this.onSelectMention(user.id, user.name)"
                                    >
                                        <i
                                            class="fa fa-user"
                                            style="margin-right: 8px;"
                                        />
                                        <span t-esc="user.name" />
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Backorder Dialog -->
            <div class="backorder_dialog_overlay" t-if="state.showBackorderDialog">
                <div class="backorder_dialog">
                    <div class="backorder_dialog_header">
                        <h4>Incomplete Transfer</h4>
                        <button
                            class="btn btn-link backorder_close_btn"
                            t-on-click="onCloseBackorderDialog"
                            title="Close"
                        >
                            <i class="fa fa-times" />
                        </button>
                    </div>

                    <div class="backorder_dialog_body">
                        <div class="backorder_message">
                            <i
                                class="fa fa-exclamation-triangle"
                                style="margin-right: 8px; color: #f0ad4e;"
                            />
                            <span
                            >You have processed less products than the initial demand.</span>
                        </div>

                        <p class="backorder_question">
                            Create a backorder if you expect to process the remaining products later.
                            Do not create a backorder if you will not process the remaining products.
                        </p>

                        <div class="backorder_table_container">
                            <table class="table table-sm backorder_table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-right">Picked</th>
                                        <th class="text-right">Demand</th>
                                        <th class="text-right">Backorder</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t
                                        t-foreach="state.backorderPendingLines"
                                        t-as="line"
                                        t-key="line_index"
                                    >
                                        <tr>
                                            <td>
                                                <div class="backorder_product_info">
                                                    <span
                                                        t-if="line.product_code"
                                                        class="backorder_product_code"
                                                        t-esc="line.product_code"
                                                    />
                                                    <span
                                                        class="backorder_product_name"
                                                        t-esc="line.product_name"
                                                    />
                                                </div>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="line.qty_picked" />
                                                <span
                                                    class="text-muted"
                                                    t-esc="' ' + line.product_uom"
                                                />
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="line.qty_demand" />
                                                <span
                                                    class="text-muted"
                                                    t-esc="' ' + line.product_uom"
                                                />
                                            </td>
                                            <td
                                                class="text-right backorder_qty_highlight"
                                            >
                                                <strong t-esc="line.qty_backorder" />
                                                <span
                                                    class="text-muted"
                                                    t-esc="' ' + line.product_uom"
                                                />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="backorder_dialog_footer">
                        <div class="backorder_footer_text">
                            <span>Create Backorder?</span>
                        </div>
                        <div class="backorder_footer_buttons">
                            <button
                                class="btn backorder_btn backorder_btn_cancel"
                                t-on-click="onCancelBackorder"
                                title="No Backorder"
                            >
                                <i class="fa fa-times" />
                            </button>
                            <button
                                class="btn backorder_btn backorder_btn_confirm"
                                t-on-click="onConfirmBackorder"
                                title="Create Backorder"
                            >
                                <i class="fa fa-check" />
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Editor Fullscreen -->
        <div t-if="state.showLineEditor" class="line_editor_screen">
            <div class="line_editor_header">
                <button
                    class="btn btn-link barcode_close_btn"
                    t-on-click="onCloseLineEditor"
                    title="Close"
                >
                    <i class="fa fa-times fa-2x" />
                </button>
                <div class="barcode_header_title">
                    <h2 class="barcode_title">Edit Line Details</h2>
                </div>
                <div style="width: 50px;" />
            </div>

            <div class="line_editor_body">
                <!-- Product Info Section -->
                <div class="line_editor_section">
                    <h5 class="section_title">Product Information</h5>
                    <div class="info_row">
                        <span class="info_label">Code:</span>
                        <span
                            class="info_value"
                            t-esc="state.lineEditorData.product_code || 'N/A'"
                        />
                    </div>
                    <div class="info_row">
                        <span class="info_label">Name:</span>
                        <span
                            class="info_value"
                            t-esc="state.lineEditorData.product_name"
                        />
                    </div>
                    <div class="info_row">
                        <span class="info_label">Tracking:</span>
                        <span class="info_value">
                            <t t-if="state.lineEditorData.tracking === 'serial'">
                                Serial Number
                            </t>
                            <t t-elif="state.lineEditorData.tracking === 'lot'">
                                Lot
                            </t>
                            <t t-else="">
                                None
                            </t>
                        </span>
                    </div>
                </div>

                <!-- Lot/Serial Section -->
                <div
                    t-if="state.lineEditorData.tracking !== 'none'"
                    class="line_editor_section"
                >
                    <h5 class="section_title">
                        <t t-if="state.lineEditorData.tracking === 'serial'">
                            Serial Number
                        </t>
                        <t t-else="">
                            Lot
                        </t>
                    </h5>
                    <div class="scan_field_display">
                        <div class="scan_field_value">
                            <i class="fa fa-barcode me-2" />
                            <span
                                t-esc="state.lineEditorData.lot_name || 'Not set'"
                            />
                        </div>
                        <button
                            t-if="state.lineEditorMode === 'view'"
                            class="btn btn-primary scan_btn"
                            t-on-click="() => this.onStartScanMode('lot')"
                        >
                            <i class="fa fa-qrcode me-2" />
                            Scan
                            <t t-if="state.lineEditorData.tracking === 'serial'">
                                Serial
                            </t>
                            <t t-else="">
                                Lot
                            </t>
                        </button>
                        <button
                            t-if="state.lineEditorMode === 'lot'"
                            class="btn btn-warning scan_btn"
                            t-on-click="onCancelScanMode"
                        >
                            <i class="fa fa-spinner fa-pulse me-2" />
                            Waiting for scan...
                        </button>
                    </div>
                </div>

                <!-- Quantity Section -->
                <div class="line_editor_section">
                    <h5 class="section_title">Quantity</h5>
                    <div class="qty_input_group">
                        <label class="form-label">Picked Quantity:</label>
                        <input
                            type="number"
                            class="form-control qty_input"
                            t-att-value="state.lineEditorData.qty_picked"
                            t-att-readonly="state.lineEditorData.tracking === 'serial'"
                            t-on-input="onLineEditorQtyChange"
                            step="0.01"
                            min="0"
                        />
                        <span
                            class="uom_label"
                            t-esc="state.lineEditorData.product_uom_name"
                        />
                    </div>
                    <div class="info_row mt-2">
                        <span class="info_label">Demand:</span>
                        <span class="info_value">
                            <t t-esc="state.lineEditorData.move_demand" />
                            <t t-esc="state.lineEditorData.product_uom_name" />
                        </span>
                    </div>
                </div>

                <!-- Destination Location Section -->
                <div class="line_editor_section">
                    <h5 class="section_title">Destination Location</h5>
                    <div class="scan_field_display">
                        <div class="scan_field_value">
                            <i class="fa fa-map-marker-alt me-2" />
                            <span
                                t-esc="state.lineEditorData.location_dest_name"
                            />
                        </div>
                        <button
                            t-if="state.lineEditorMode === 'view'"
                            class="btn btn-primary scan_btn"
                            t-on-click="() => this.onStartScanMode('location_dest')"
                        >
                            <i class="fa fa-qrcode me-2" />
                            Scan Location
                        </button>
                        <button
                            t-if="state.lineEditorMode === 'location_dest'"
                            class="btn btn-warning scan_btn"
                            t-on-click="onCancelScanMode"
                        >
                            <i class="fa fa-spinner fa-pulse me-2" />
                            Waiting for scan...
                        </button>
                    </div>
                </div>

                <!-- Package Section -->
                <div class="line_editor_section">
                    <h5 class="section_title">Source Package</h5>
                    <div class="scan_field_display">
                        <div class="scan_field_value">
                            <i class="fa fa-box me-2" />
                            <span
                                t-esc="state.lineEditorData.package_name || 'Not set'"
                            />
                        </div>
                        <button
                            t-if="state.lineEditorMode === 'view'"
                            class="btn btn-primary scan_btn"
                            t-on-click="() => this.onStartScanMode('package')"
                        >
                            <i class="fa fa-qrcode me-2" />
                            Scan Package
                        </button>
                        <button
                            t-if="state.lineEditorMode === 'package'"
                            class="btn btn-warning scan_btn"
                            t-on-click="onCancelScanMode"
                        >
                            <i class="fa fa-spinner fa-pulse me-2" />
                            Waiting for scan...
                        </button>
                    </div>
                </div>

                <!-- Result Package Section -->
                <div class="line_editor_section">
                    <h5 class="section_title">Destination Package</h5>
                    <div class="scan_field_display">
                        <div class="scan_field_value">
                            <i class="fa fa-box-open me-2" />
                            <span
                                t-esc="state.lineEditorData.result_package_name || 'Not set'"
                            />
                        </div>
                        <button
                            t-if="state.lineEditorMode === 'view'"
                            class="btn btn-primary scan_btn"
                            t-on-click="() => this.onStartScanMode('result_package')"
                        >
                            <i class="fa fa-qrcode me-2" />
                            Scan Package
                        </button>
                        <button
                            t-if="state.lineEditorMode === 'result_package'"
                            class="btn btn-warning scan_btn"
                            t-on-click="onCancelScanMode"
                        >
                            <i class="fa fa-spinner fa-pulse me-2" />
                            Waiting for scan...
                        </button>
                    </div>
                </div>
            </div>

            <div class="line_editor_footer">
                <button
                    class="btn btn-lg btn-secondary flex-fill me-2"
                    t-on-click="onCloseLineEditor"
                >
                    <i class="fa fa-times me-2" />
                    Cancel
                </button>
                <button
                    class="btn btn-lg btn-primary flex-fill"
                    t-on-click="onSaveLineEditor"
                    t-att-disabled="state.lineEditorMode !== 'view'"
                >
                    <i class="fa fa-check me-2" />
                    Save
                </button>
            </div>
        </div>
    </t>
</templates>
