#### Cambio 1: `_create_or_update_move_line_for_serial()` (línea ~620)

```python
def _create_or_update_move_line_for_serial(self, move, lot_id, picking, context):
    """
    Lógica GENÉRICA usando qty_picked (campo de stock.move.line).

    IMPORTANTE: qty_picked existe en move.move_line_ids, NO en move directamente.
    Para obtener total del move, usar: move._get_picked_quantity()
    """

    # Buscar move_lines NO escaneados (qty_picked == 0)
    available_lines = move.move_line_ids.filtered(
        lambda ml: ml.qty_picked == 0  # ✅ Campo existe en move_line
    )

    # ESCENARIO 1: VERIFICACIÓN
    line_with_this_serial = available_lines.filtered(
        lambda ml: ml.lot_id and ml.lot_id.id == lot_id
    )

    if line_with_this_serial:
        line_with_this_serial[0].write({'qty_picked': 1.0})  # ✅ OK
        return {
            "success": True,
            "message": _("Serial %(serial)s verified") % {
                "serial": line_with_this_serial[0].lot_id.name
            },
            "move_line_id": line_with_this_serial[0].id,
        }

    # ESCENARIO 2: ASIGNACIÓN
    line_without_serial = available_lines.filtered(lambda ml: not ml.lot_id)

    if line_without_serial:
        line_without_serial[0].write({
            'lot_id': lot_id,
            'qty_picked': 1.0,  # ✅ OK
        })
        lot = self.env['stock.lot'].browse(lot_id)
        return {
            "success": True,
            "message": _("Serial %(serial)s assigned") % {"serial": lot.name},
            "move_line_id": line_without_serial[0].id,
        }

    # VALIDACIÓN: SERIAL INCORRECTO
    if available_lines:
        expected_serials = available_lines.mapped('lot_id.name')
        scanned_lot = self.env['stock.lot'].browse(lot_id)
        return {
            "success": False,
            "message": _("Expected serial %(expected)s, but got %(actual)s") % {
                "expected": " or ".join(expected_serials) if expected_serials else "any available",
                "actual": scanned_lot.name,
            },
        }

    # ESCENARIO 3: CREACIÓN
    picked_quantities = context.get("picked_quantities", {})
    current_picked = picked_quantities.get(str(move.id), 0)

    if current_picked >= move.product_uom_qty:
        return {
            "success": False,
            "message": _("Cannot add more: demand already met (%(qty)s/%(demand)s)") % {
                "qty": current_picked,
                "demand": move.product_uom_qty,
            },
        }

    move_line_vals = {
        'move_id': move.id,
        'product_id': move.product_id.id,
        'lot_id': lot_id,
        'qty_picked': 1.0,    # ✅ OK - campo existe
        'quantity': 1.0,      # También quantity
        'product_uom_id': move.product_uom.id,
        'location_id': move.location_id.id,
        'location_dest_id': move.location_dest_id.id,
        'picking_id': picking.id,
    }

    move_line = self.env['stock.move.line'].create(move_line_vals)

    return {
        "success": True,
        "message": _("Serial %(serial)s added") % {"serial": move_line.lot_id.name},
        "move_line_id": move_line.id,
    }
```

